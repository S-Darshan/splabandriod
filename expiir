clc;
clear;
close all;

% STEP 1: Define filter specifications
f = [0 0.2 0.4 0.41 1];
m = [0 1 1 0 0];
n = 8;

% Design the IIR filter using Yule-Walker method
[b,a] = yulewalk(n,f,m);

% STEP 2: Plot filter frequency response
[H,w] = freqz(b,a,1024);

figure;
plot(w/pi,abs(H),'LineWidth',1.2);
title('Designed IIR Bandpass Filter');
xlabel('Normalized Frequency');
ylabel('Magnitude');
grid on;


% STEP 3: Convert filter into Second-Order Sections
sos = tf2sos(b,a);

% STEP 4: Generate a chirp input signal
fs = 8000;
t = 0:1/fs:1-1/fs;

% Generate chirp from 0 Hz to fs/2 = 4000 Hz
x = chirp(t,0,t(end),fs/2);

% STEP 5: Filter using Direct Form and SOS
% Direct Form filtering
y_direct = filter(b,a,x);

% SOS cascade filtering
Z = x;

for i = 1:size(sos,1)

    % Filter using each second-order section
    Z = filter(sos(i,1:3),sos(i,4:6),Z);

end

% Final SOS unquantized output
y_sos_unquant = Z;

% STEP 6: Fixed-point quantization settings
total_bits = 20;
integer_bits = 8;

% Calculate number of fractional bits
frac_bits = total_bits - integer_bits - 1;

% Quantize Direct Form coefficients
scale = 2^frac_bits;

bq = round(b*scale)/scale;
aq = round(a*scale)/scale;

% Quantize SOS coefficients 
sos_q = round(sos*scale)/scale;

% STEP 7: Filter using quantized coefficients

% Direct Form quantized filtering
y_direct_quant = filter(bq,aq,x);

% SOS quantized filtering
Z_q = x;

for i = 1:size(sos_q,1)

    % Filter through each quantized second-order section
    Z_q = filter(sos_q(i,1:3),sos_q(i,4:6),Z_q);

end

% Final SOS quantized output
y_sos_quant = Z_q;

% STEP 8: Calculate FFT of the outputs
N = length(x);

% Create frequency axis
f_axis = (0:N-1)*(fs/N);

% FFT of Direct Form unquantized output
Y_dir_unquant = fft(y_direct,N);

% FFT of Direct Form quantized output
Y_dir_quant = fft(y_direct_quant,N);

% FFT of SOS quantized output
Y_sos_quant = fft(y_sos_quant,N);

% STEP 9: Plot output spectra comparison
figure;

% Original Direct Form spectrum
subplot(3,1,1);
plot(f_axis(1:N/2),abs(Y_dir_unquant(1:N/2)));
title('Direct Form Spectrum - Unquantized');
xlabel('Frequency (Hz)');
ylabel('Magnitude');
grid on;

% Quantized Direct Form spectrum
subplot(3,1,2);
plot(f_axis(1:N/2),abs(Y_dir_quant(1:N/2)));
title(['Direct Form Spectrum - Quantized ' num2str(total_bits) ' bits']);
xlabel('Frequency (Hz)');
ylabel('Magnitude');
grid on;

% Quantized SOS spectrum
subplot(3,1,3);
plot(f_axis(1:N/2),abs(Y_sos_quant(1:N/2)));
title(['SOS Cascade Spectrum - Quantized ' num2str(total_bits) ' bits']);
xlabel('Frequency (Hz)');
ylabel('Magnitude');
grid on;
